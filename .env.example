# Environment variables for Kiro Registration Bot

# Google OAuth credentials (if using direct OAuth flow)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/callback

# 9router API configuration
NINEROUTER_API_KEY=your_9router_api_key_here
NINEROUTER_API_SECRET=your_9router_api_secret_here

# Kiro API credentials (optional)
KIRO_API_KEY=your_kiro_api_key_here

# Proxy settings (optional)
PROXY_HOST=proxy.example.com
PROXY_PORT=8080
PROXY_USER=proxy_user
PROXY_PASS=proxy_password

# Rate limiting (requests per minute)
RATE_LIMIT=10